# fix-20: VDMA revival experiment on live board (v6 debug boot)
#
# Root cause (RTL + ILA evidence): app lcd_init writes VSIZE (0x50) BEFORE
# setting RS (CR bit0). The all_idle rising edge generated by the VSIZE write
# is swallowed by fsync_gen (run_stop=0), so video_prmtrs_valid never sets,
# the command FSM stays in IDLE and zero AXI-read commands are issued.
#
# Xilinx driver XAxiVdma_ChannelStart does the opposite order:
#   1. CR |= RS (xaxivdma_channel.c:995)
#   2. VSIZE written LAST - "Update vsize to start the channel" (:1018)
#
# Revival sequence from the stuck state:
#   halt (CR=0) -> rewrite geometry -> RS=1 FIRST -> VSIZE LAST.

set VDMA 0x43000000
set CR   $VDMA
set SR   [expr {$VDMA + 0x04}]
set PARK [expr {$VDMA + 0x28}]
set VER  [expr {$VDMA + 0x2C}]
set VSZ  [expr {$VDMA + 0x50}]
set HSZ  [expr {$VDMA + 0x54}]
set STRD [expr {$VDMA + 0x58}]
set SA0  [expr {$VDMA + 0x5C}]
set SA1  [expr {$VDMA + 0x60}]
set SA2  [expr {$VDMA + 0x64}]

proc rv {addr} {
    set out [mrd -force $addr 1]
    set val "NA"
    foreach line [split $out "\n"] {
        if {[regexp {[0-9A-Fa-f]+:\s+([0-9A-Fa-f]+)} $line -> v]} { set val $v }
    }
    return $val
}

connect -url tcp:127.0.0.1:3121
targets -set -filter {name =~ "ARM Cortex-A9 MPCore #0"}

puts "=== PHASE 0: pre-state ==="
puts "VER   = [rv $VER]"
puts "CR    = [rv $CR]"
puts "SR    = [rv $SR]"
puts "PARK  = [rv $PARK]"
puts "VSIZE = [rv $VSZ]"
puts "HSIZE = [rv $HSZ]"
puts "STRIDE= [rv $STRD]"
puts "SA0/1/2 = [rv $SA0] / [rv $SA1] / [rv $SA2]"

puts "=== PHASE 1: DAP write-path sanity (PARKPTR w/r) ==="
mwr -force $PARK 0x00000001
set p1 [rv $PARK]
mwr -force $PARK 0x00000000
set p0 [rv $PARK]
puts "PARK wr1->$p1 wr0->$p0"
if {$p1 != "00000001" || $p0 != "00000000"} {
    puts "FATAL: DAP write path dead on v6 - aborting before CR changes"
    exit 1
}

puts "=== PHASE 2: halt channel (CR=0), wait HALTED=1 ==="
mwr -force $CR 0x00000000
set halted 0
set sr "NA"
for {set i 0} {$i < 20} {incr i} {
    set sr [rv $SR]
    if {$sr ne "NA"} {
        set srn "0x$sr"
        if {[expr {$srn & 0x1}] == 1} { set halted 1; break }
    }
    after 50
}
puts "halted=$halted SR=$sr CR=[rv $CR]"
if {!$halted} {
    puts "WARN: HALTED never asserted - continuing (FSM was stuck in IDLE)"
}

puts "=== PHASE 3: rewrite geometry (RS still 0, safe) ==="
mwr -force $PARK 0x00000000
mwr -force $HSZ  0x00000960
mwr -force $STRD 0x00000960
mwr -force $SA0  0x18000000
mwr -force $SA1  0x18119400
mwr -force $SA2  0x18232800
puts "geometry: HSIZE=[rv $HSZ] STRIDE=[rv $STRD] SA0=[rv $SA0] SA1=[rv $SA1] SA2=[rv $SA2]"

puts "=== PHASE 4: RS=1 FIRST (CR=RS|TailEn|FrmCntEn|Thresh=0xFF) ==="
mwr -force $CR 0x00FF0013
puts "CR = [rv $CR]"

puts "=== PHASE 5: VSIZE=480 LAST (starting gun) ==="
mwr -force $VSZ 0x000001E0
puts "VSIZE = [rv $VSZ]"

puts "=== PHASE 6: poll SR for FRMCNT growth / error bits ==="
for {set i 0} {$i < 6} {incr i} {
    after 400
    puts "SR\[$i\] = [rv $SR]"
}
puts "=== final ==="
puts "CR=[rv $CR] SR=[rv $SR] VSIZE=[rv $VSZ] HSIZE=[rv $HSZ]"
puts "REVIVE-EXPERIMENT-DONE"
exit 0
