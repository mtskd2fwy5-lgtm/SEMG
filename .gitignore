# Vivado-generated project state (regenerable via build/create_project.tcl),
# except the block-design sources, which are hand-built and tracked:
#   build/vivado/hand_motion_reconstruction.srcs/sources_1/bd/
build/vivado/*
!build/vivado/hand_motion_reconstruction.srcs
build/vivado/hand_motion_reconstruction.srcs/*
!build/vivado/hand_motion_reconstruction.srcs/sources_1
build/vivado/hand_motion_reconstruction.srcs/sources_1/*
!build/vivado/hand_motion_reconstruction.srcs/sources_1/bd

# Top-level Vivado session artifacts
.Xil/
vivado*.jou
vivado*.log
vivado*.backup.*
dfx_runtime.txt
clockInfo.txt

# One-off tool logs and editor backups
/*.log
*.bak

# Root-level xvlog/xsim leftovers (run sims from sim/results*/ instead)
/xvlog.log
/xvlog.pb
/xsim.dir/

# Build-script logs and batch journals (regenerated per Vivado run)
build/*.log
build/*.backup.*
build/*.jou

# Hardware export artifacts (regenerated: XSA zip + extracted ps7_init)
build/export/

# Boot image binary (regenerate via bootgen with build/boot/boot_image.bif)
build/boot/BOOT.bin

# Extracted datasheet text (debug scratch, from the TI PDF)
build/debug/ads1299_datasheet.txt

# Vitis unified IDE workspace (regenerable; app sources and scripts live in sw/)
build/vitis_ws/

# Bare-metal build outputs
sw/**/*.elf
sw/**/*.bin

# XSim-generated state (entire tree is regenerable via build/scripts/run_*.bat)
sim/results*/
sim/results*/*.jou
sim/results*/*.log
sim/results*/*.wdb
sim/results*/*.backup.*
sim/results*/xvlog.*
sim/results*/xelab.*
sim/results*/dfx_runtime.txt
sim/results*/*.pb

# Generated stimulus and sim output (regenerate via tools/emg_reference.py)
sim/results*/*_stim.txt
sim/results*/*_out.csv

# Local Vivado user configuration
.vivado_*/

# Python byte-compiled cache
__pycache__/
*.pyc

# Scratch space
tmp/

# Local datasets and generated metrics
data/raw/*.csv
data/raw/
data/processed/*.csv
data/metrics/*.json

# Reference PDFs stay out of the repo (guide requires ASCII-only filenames)
*.pdf

# Local editor/AI tool state and renderer/simulator scratch outputs
/.trae/
/.trae-html-share-packages/
/.vivado-ai/
/*.ppm
/*.wdb
/xelab.pb
/xsim*.jou
/~$*.docx

# Versioned boot candidates are rebuilt from source; hashes live in reports
build/boot/BOOT_*.BIN

# First-round training originals are tracked as BIN; regenerate expanded waves
report/rehab_round1_20261023/EMG000_raw.csv
report/rehab_round1_20261023/EMG000_processed.csv
